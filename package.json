{
  "name": "vidtotab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Turns guitar tab videos into printable songsheets.",
  "author": "KXYZ6753 <KXYZ6753@users.noreply.github.com>",
  "homepage": "https://github.com/KXYZ6753/VidToTab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KXYZ6753/VidToTab.git"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/test.mjs",
    "test:server": "node scripts/server-test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "eval": "node scripts/eval.mjs",
    "eval:tabs": "node scripts/tabread-eval.mjs",
    "eval:listen": "node scripts/eval-listen.mjs",
    "test:listen": "node scripts/listen-test.mjs",
    "eval:clips": "node scripts/eval-clips.mjs",
    "e2e:listen": "node scripts/listen-e2e.mjs",
    "app": "electron .",
    "test:app": "node scripts/app-test.mjs",
    "pack": "npm run icon && electron-builder --dir",
    "dist": "npm run icon && electron-builder --publish never",
    "test:app:packaged": "node scripts/app-test.mjs --packaged",
    "binaries": "node scripts/fetch-binaries.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.cjs"
}
